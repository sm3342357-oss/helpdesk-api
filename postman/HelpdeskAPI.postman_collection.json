    {
      "name": "Seguridad - Pruebas de Control de Acceso",
      "item": [
        {
          "name": "GET /api/tickets (Sin token - debe fallar 401)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/tickets (Token inválido - debe fallar 401)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets"]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer token_invalido_aqui"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/admin/soporte (Rol USUARIO - debe fallar 403)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/admin/soporte",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "soporte"]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"otro@test.com\"\n}"
            }
          },
          "event": [
