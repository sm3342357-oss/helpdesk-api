{
  "info": {
    "name": "Helpdesk API",
    "description": "Colección completa de endpoints para la API de Mesa de Ayuda con SLA",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "ticketId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Ping",
      "item": [
        {
          "name": "GET /api/ping",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/ping",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ping"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is pong', () => {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.message).to.eql('pong');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "POST /api/auth/registro",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "registro"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Perez\",\n  \"email\": \"juan@test.com\",\n  \"password\": \"123456\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Response has user data', () => {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.have.property('id');",
                  "    pm.expect(data.email).to.eql('juan@test.com');",
                  "    pm.expect(data.rol).to.eql('USUARIO');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/login",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan@test.com\",\n  \"password\": \"123456\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Returns tokens', () => {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.have.property('accessToken');",
                  "    pm.expect(data).to.have.property('refreshToken');",
                  "    pm.expect(data.tokenType).to.eql('Bearer');",
                  "    pm.collectionVariables.set('accessToken', data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/refresh",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Returns new tokens', () => {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.have.property('accessToken');",
                  "    pm.expect(data).to.have.property('refreshToken');",
                  "    pm.collectionVariables.set('accessToken', data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Logout message', () => {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.message).to.eql('Logout exitoso');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/auth/me",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('User data', () => {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.have.property('email');",
                  "    pm.expect(data).to.have.property('rol');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/refresh (token revocado - debe fallar 401)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Tickets",
      "item": [
        {
          "name": "POST /api/tickets (Crear ticket)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets"]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Error al iniciar sesión\",\n  \"descripcion\": \"No puedo acceder al sistema desde ayer\",\n  \"prioridad\": \"ALTA\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Ticket created with SLA', () => {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.have.property('id');",
                  "    pm.expect(data.titulo).to.eql('Error al iniciar sesión');",
                  "    pm.expect(data.prioridad).to.eql('ALTA');",
                  "    pm.expect(data.estado).to.eql('ABIERTO');",
                  "    pm.expect(data).to.have.property('slaVenceEn');",
                  "    pm.expect(data.vencido).to.be.false;",
                  "    pm.collectionVariables.set('ticketId', data.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/tickets/mios",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tickets/mios",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "mios"]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Returns array of tickets', () => {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/tickets/{id}",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{ticketId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{ticketId}}"]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Ticket details', () => {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.have.property('id');",
                  "    pm.expect(data).to.have.property('titulo');",
                  "    pm.expect(data).to.have.property('slaVenceEn');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/tickets (Todos - requiere SOPORTE/ADMIN)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets"]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 403', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns array', () => {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /api/tickets/{id}/estado (Cambiar estado)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/estado",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{ticketId}}", "estado"]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"EN_PROCESO\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Estado actualizado', () => {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.estado).to.eql('EN_PROCESO');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/tickets/vencidos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tickets/vencidos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "vencidos"]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Returns array', () => {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
